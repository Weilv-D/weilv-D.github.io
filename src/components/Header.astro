---
import ThemeToggle from './ThemeToggle.astro';
import Search from './Search';

const base = import.meta.env.BASE_URL;
const avatarUrl = `${base}avatar.png`;
---

<header id="site-header" class="sticky top-0 z-50 w-full transition-all duration-500 border-b border-transparent">
  <div class="max-w-6xl mx-auto px-5 md:px-10">
    <div id="header-inner" class="flex justify-between items-center h-20 md:h-24 transition-all duration-500">
      <!-- Logo -->
      <a href={base} class="flex items-center gap-3 group" aria-label="未来回忆录首页">
        <div class="relative w-9 h-9">
          <div class="absolute inset-0 rounded-full border border-[var(--color-accent)] opacity-0 scale-75 group-hover:opacity-40 group-hover:scale-125 transition-all duration-500 ease-out"></div>
          <div class="absolute inset-0 flex items-center justify-center text-[var(--color-primary)] transition-transform duration-700 group-hover:rotate-12 group-hover:scale-105">
            <img src={`${base}logo.svg`} alt="" width="36" height="36" class="w-full h-full dark:invert" />
          </div>
        </div>
        <span class="text-xl font-display font-bold tracking-tight text-[var(--color-primary)] group-hover:opacity-70 transition-opacity hidden md:block whitespace-nowrap">
          未来回忆录
        </span>
      </a>

      <!-- Navigation -->
      <nav class="flex items-center gap-3 md:gap-8" aria-label="主导航">
        <Search client:load />

        <a
          href={`${base}blog`}
          id="nav-blog"
          data-nav="blog"
          class="relative text-[11px] md:text-sm font-sans font-semibold tracking-wide text-[var(--color-secondary)] hover:text-[var(--color-primary)] transition-colors uppercase py-2"
        >
          Blog
          <span class="nav-indicator absolute bottom-0 left-0 w-full h-[2px] bg-[var(--color-accent)] scale-x-0 transition-transform duration-300 origin-left"></span>
        </a>
        <a
          href={`${base}tags`}
          id="nav-tags"
          data-nav="tags"
          class="relative text-[11px] md:text-sm font-sans font-semibold tracking-wide text-[var(--color-secondary)] hover:text-[var(--color-primary)] transition-colors uppercase py-2"
        >
          Tags
          <span class="nav-indicator absolute bottom-0 left-0 w-full h-[2px] bg-[var(--color-accent)] scale-x-0 transition-transform duration-300 origin-left"></span>
        </a>
        <a
          href={`${base}about`}
          id="nav-about"
          data-nav="about"
          class="relative text-[11px] md:text-sm font-sans font-semibold tracking-wide text-[var(--color-secondary)] hover:text-[var(--color-primary)] transition-colors uppercase py-2"
        >
          About
          <span class="nav-indicator absolute bottom-0 left-0 w-full h-[2px] bg-[var(--color-accent)] scale-x-0 transition-transform duration-300 origin-left"></span>
        </a>

        <a
          href={`${base}about`}
          class="hidden sm:block w-9 h-9 rounded overflow-hidden border border-[var(--color-border)] hover:border-[var(--color-accent)] hover:scale-105 transition-all duration-300 ml-1"
          aria-label="关于 weilv"
        >
          <img src={avatarUrl} alt="weilv" width="36" height="36" loading="lazy" decoding="async" class="w-full h-full object-cover" />
        </a>

        <ThemeToggle />
      </nav>
    </div>
  </div>
</header>

<script>
  function updateHeader() {
    const header = document.getElementById('site-header');
    const headerInner = document.getElementById('header-inner');
    const scrolled = window.scrollY > 60;
    header?.classList.toggle('header-glass', scrolled);
    header?.classList.toggle('border-transparent', !scrolled);
    headerInner?.classList.toggle('h-16', scrolled);
    headerInner?.classList.toggle('md:h-18', scrolled);
    headerInner?.classList.toggle('h-20', !scrolled);
    headerInner?.classList.toggle('md:h-24', !scrolled);
  }

  function updateActiveNav() {
    const path = window.location.pathname;
    const base = import.meta.env.BASE_URL || '/';
    const rest = path.startsWith(base) ? path.slice(base.length) : path;

    document.querySelectorAll<HTMLElement>('.nav-indicator').forEach((el) => el.classList.remove('scale-x-100'));
    document.querySelectorAll<HTMLElement>('[data-nav]').forEach((el) => el.removeAttribute('aria-current'));

    let active: string | null = null;
    if (rest === 'tags' || rest.startsWith('tags/')) active = 'tags';
    else if (rest === 'blog' || rest.startsWith('blog/')) active = 'blog';
    else if (rest === 'about' || rest.startsWith('about/')) active = 'about';

    if (active) {
      const link = document.querySelector<HTMLElement>(`#nav-${active}`);
      link?.querySelector('.nav-indicator')?.classList.add('scale-x-100');
      link?.setAttribute('aria-current', 'page');
    }
  }

  window.addEventListener('scroll', updateHeader, { passive: true });
  updateHeader();
  updateActiveNav();

  document.addEventListener('astro:page-load', () => {
    updateHeader();
    updateActiveNav();
  });
</script>
