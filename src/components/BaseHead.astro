---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: string;
	noindex?: boolean;
	article?: {
		pubDate: Date;
		updatedDate?: Date;
		category: string;
		tags: string[];
	};
}

const { title, description, image = '/og-default.png', noindex = false, article } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// SVG covers are not supported by most social cards; fall back to the static PNG.
const safeImage = /\.svg(\?|$)/i.test(image) ? '/og-default.png' : image;
const imageURL = new URL(
	safeImage.startsWith('/') ? import.meta.env.BASE_URL + safeImage.slice(1) : safeImage,
	Astro.site,
);
const isDefaultOg = imageURL.pathname.endsWith('/og-default.png');
const displayTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;
const baseUrl = import.meta.env.BASE_URL;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={`${baseUrl}rss.xml`} />

<meta name="generator" content={Astro.generator} />
<meta name="author" content="weilv" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#F7F3EB" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1C1C1E" />
<meta name="color-scheme" content="light dark" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{displayTitle}</title>
<meta name="title" content={displayTitle} />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:title" content={displayTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={title} />
{isDefaultOg && <meta property="og:image:width" content="1200" />}
{isDefaultOg && <meta property="og:image:height" content="630" />}
{isDefaultOg && <meta property="og:image:type" content="image/png" />}
{article && (
  <>
    <meta property="article:published_time" content={article.pubDate.toISOString()} />
    {article.updatedDate && <meta property="article:modified_time" content={article.updatedDate.toISOString()} />}
    <meta property="article:author" content="weilv" />
    <meta property="article:section" content={article.category} />
    {article.tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
  </>
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={displayTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<ClientRouter />

<!-- Theme + JS flag must run before first paint -->
<script is:inline>
  document.documentElement.classList.add('js');

  const getThemePreference = () => {
    try {
      const stored = localStorage.getItem('theme');
      if (stored) return stored;
    } catch {}
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  };

  const setDarkClass = () => {
    document.documentElement.classList.toggle('dark', getThemePreference() === 'dark');
  };

  setDarkClass();
  document.addEventListener('astro:after-swap', setDarkClass);
</script>
